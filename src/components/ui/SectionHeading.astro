---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}

const { title, subtitle, align = 'left', dark = false } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class={`mb-8 md:mb-12 max-w-2xl ${alignClass}`}>
  <div class="flex items-center gap-3 mb-3">
    <div class="rivet shrink-0" aria-hidden="true"></div>
    <div class={`h-px flex-1 max-w-16 ${dark ? 'bg-steel-600' : 'bg-steel-300'}`} aria-hidden="true"></div>
  </div>
  <h2
    class={`text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight ${dark ? 'text-white' : 'text-steel-900'}`}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class={`mt-3 text-base sm:text-lg leading-relaxed ${dark ? 'text-steel-300' : 'text-steel-500'}`}>
        {subtitle}
      </p>
    )
  }
</div>
