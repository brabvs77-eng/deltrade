---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb?: { label: string; href?: string }[];
}

const { title, subtitle, breadcrumb } = Astro.props;
---

<section class="steel-section py-10 sm:py-14">
  <div class="section-container">
    {
      breadcrumb && breadcrumb.length > 0 && (
        <nav class="text-sm text-steel-400 mb-4" aria-label="Хлебные крошки">
          {breadcrumb.map((item, i) => (
            <>
              {i > 0 && <span class="mx-2">/</span>}
              {item.href ? (
                <a href={item.href} class="hover:text-white">{item.label}</a>
              ) : (
                <span class="text-steel-300">{item.label}</span>
              )}
            </>
          ))}
        </nav>
      )
    }
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">{title}</h1>
    {subtitle && <p class="mt-3 text-steel-300 max-w-2xl text-base sm:text-lg">{subtitle}</p>}
  </div>
  <div class="chrome-line mt-8" aria-hidden="true"></div>
</section>
