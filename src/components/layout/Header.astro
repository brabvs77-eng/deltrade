---
import { SITE, NAV_LINKS } from '../../lib/constants';
---

<header class="sticky top-0 z-50 steel-section border-b border-steel-700/50 backdrop-blur-md bg-steel-900/90">
  <div class="section-container">
    <div class="flex items-center justify-between h-14 sm:h-16">
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="DELDIN TRADE — на главную">
        <img
          src="/images/logo-color.png"
          alt="DELDIN TRADE"
          width="36"
          height="36"
          class="rounded-md"
          loading="eager"
        />
        <div class="hidden sm:block">
          <span class="text-white font-bold text-sm tracking-wide leading-none">DELDIN</span>
          <span class="text-steel-400 font-medium text-xs tracking-widest leading-none block">TRADE</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Основная навигация">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 text-sm text-steel-300 hover:text-white transition-colors rounded-md hover:bg-white/5"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={SITE.phoneHref}
          class="hidden sm:flex items-center gap-1.5 text-sm text-steel-300 hover:text-white transition-colors"
          aria-label={`Позвонить: ${SITE.phone}`}
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="hidden md:inline">{SITE.phone}</span>
        </a>
        <a
          href="#zayavka"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold bg-brand text-white rounded-lg hover:bg-brand-light transition-colors min-h-[40px]"
        >
          Заявка
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden flex items-center justify-center w-10 h-10 text-steel-300 hover:text-white rounded-lg hover:bg-white/5 transition-colors"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="mobile-sheet"
        >
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile bottom sheet -->
  <div id="mobile-sheet-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
  <div
    id="mobile-sheet"
    class="fixed inset-x-0 bottom-0 z-50 lg:hidden translate-y-full transition-transform duration-300 ease-out"
    role="dialog"
    aria-modal="true"
    aria-label="Мобильное меню"
  >
    <div class="rounded-t-2xl steel-section border-t border-steel-600 shadow-2xl max-h-[85vh] overflow-y-auto">
      <div class="flex justify-center pt-3 pb-1" aria-hidden="true">
        <div class="w-10 h-1 rounded-full bg-steel-600"></div>
      </div>
      <nav class="section-container py-4 pb-8 flex flex-col gap-1" aria-label="Мобильная навигация">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link px-4 py-3.5 text-base text-steel-200 hover:text-white hover:bg-white/5 rounded-xl transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={SITE.phoneHref}
          class="mobile-nav-link px-4 py-3.5 text-base text-brand-light font-medium mt-2"
        >
          {SITE.phone}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const sheet = document.getElementById('mobile-sheet');
  const backdrop = document.getElementById('mobile-sheet-backdrop');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openSheet() {
    backdrop?.classList.remove('hidden');
    requestAnimationFrame(() => {
      backdrop?.classList.remove('opacity-0');
      sheet?.classList.remove('translate-y-full');
    });
    toggle?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeSheet() {
    backdrop?.classList.add('opacity-0');
    sheet?.classList.add('translate-y-full');
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
    setTimeout(() => backdrop?.classList.add('hidden'), 300);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeSheet();
    else openSheet();
  });

  backdrop?.addEventListener('click', closeSheet);
  navLinks.forEach((link) => link.addEventListener('click', closeSheet));
</script>
