---
import { SITE, NAV_LINKS, CATALOG_DIRECTIONS } from '../../lib/constants';
const year = new Date().getFullYear();
---

<footer class="steel-section text-steel-300">
  <div class="chrome-line" aria-hidden="true"></div>
  <div class="section-container py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/images/logo-color.png" alt="" width="32" height="32" class="rounded-md" loading="lazy" />
          <div>
            <span class="text-white font-bold text-sm">DELDIN TRADE</span>
            <span class="text-steel-500 text-xs block">{SITE.legalName}</span>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-steel-400">
          Комплексные поставки металлопроката и материалов для строительства и промышленности.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Навигация</h3>
        <ul class="space-y-2">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Catalog -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Каталог</h3>
        <ul class="space-y-2">
          {CATALOG_DIRECTIONS.slice(0, 6).map((dir) => (
            <li>
              <a href={`/katalog/${dir.slug}/`} class="text-sm hover:text-white transition-colors">{dir.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacts -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Контакты</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={SITE.phoneHref} class="hover:text-white transition-colors">{SITE.phone}</a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-white transition-colors">{SITE.email}</a>
          </li>
          <li class="text-steel-500">{SITE.workHours}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-steel-700/50 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-steel-500">
      <p>&copy; {year} {SITE.legalName}. Все права защищены.</p>
      <div class="flex gap-4">
        <a href="/politika-konfidencialnosti/" class="hover:text-steel-300 transition-colors">Политика конфиденциальности</a>
      </div>
    </div>
  </div>
</footer>
