---
import { SITE } from '../../lib/constants';
---

<div
  class="fixed bottom-0 inset-x-0 z-40 md:hidden metal-surface metal-border border-t border-steel-300"
  role="complementary"
  aria-label="Быстрые действия"
>
  <div class="flex items-stretch h-[3.5rem]">
    <a
      href={SITE.phoneHref}
      class="flex-1 flex items-center justify-center gap-2 text-steel-800 font-semibold text-sm border-r border-steel-300/60 active:bg-steel-200/50 transition-colors"
      aria-label={`Позвонить: ${SITE.phone}`}
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      Позвонить
    </a>
    <a
      href="#zayavka"
      class="flex-1 flex items-center justify-center gap-2 bg-brand text-white font-semibold text-sm active:bg-brand-dark transition-colors"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      Заявка
    </a>
  </div>
</div>
