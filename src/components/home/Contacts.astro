---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/constants';

const items = [
  {
    title: 'Телефон',
    icon: 'phone',
    content: SITE.phone,
    href: SITE.phoneHref,
    external: false,
  },
  {
    title: 'Email',
    icon: 'mail',
    content: SITE.email,
    href: `mailto:${SITE.email}`,
    external: false,
  },
  {
    title: 'Адрес',
    icon: 'pin',
    content: SITE.address,
    href: null,
    external: false,
  },
  {
    title: 'Режим работы',
    icon: 'clock',
    content: SITE.workHours,
    href: null,
    external: false,
  },
];
---

<section class="steel-section diamond-plate relative py-14 sm:py-20 weld-seam">
  <div class="chrome-line mb-0" aria-hidden="true"></div>

  <div class="section-container relative">
    <SectionHeading
      title="Контакты"
      subtitle="Свяжитесь с нами — ответим в рабочее время"
      align="center"
      dark
    />

    <div class="max-w-4xl mx-auto rounded-2xl metal-border-dark overflow-hidden shadow-2xl">
      <!-- Metal header bar -->
      <div class="metal-surface-dark px-5 py-3 flex items-center justify-between gap-3 border-b border-steel-600" aria-hidden="true">
        <div class="flex items-center gap-2">
          <div class="rivet"></div>
          <div class="rivet"></div>
          <div class="rivet"></div>
          <span class="ml-2 text-xs uppercase tracking-widest text-steel-400 font-medium">DELDIN TRADE</span>
        </div>
        <span class="text-xs text-steel-500 hidden sm:inline">Офис · Московская область</span>
      </div>

      <div class="p-4 sm:p-6 perforated-bg">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {
            items.map((item) => (
              <div class="group relative rounded-xl metal-border-dark metal-surface-dark p-5 sm:p-6 text-center transition-transform hover:-translate-y-0.5">
                <!-- Corner rivets -->
                <div class="absolute top-2.5 left-2.5 rivet opacity-70" aria-hidden="true"></div>
                <div class="absolute top-2.5 right-2.5 rivet opacity-70" aria-hidden="true"></div>
                <div class="absolute bottom-2.5 left-2.5 rivet opacity-70" aria-hidden="true"></div>
                <div class="absolute bottom-2.5 right-2.5 rivet opacity-70" aria-hidden="true"></div>

                <div class="mx-auto mb-3 w-10 h-10 rounded-lg metal-border flex items-center justify-center bg-steel-800/50 text-steel-300">
                  {
                    item.icon === 'phone' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                    )
                  }
                  {
                    item.icon === 'mail' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                      </svg>
                    )
                  }
                  {
                    item.icon === 'pin' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    )
                  }
                  {
                    item.icon === 'clock' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    )
                  }
                </div>

                <h3 class="font-semibold text-steel-200 text-xs uppercase tracking-wider">{item.title}</h3>
                {
                  item.href ? (
                    <a
                      href={item.href}
                      class="mt-2 block text-brand-light font-medium text-sm sm:text-base hover:text-white transition-colors"
                    >
                      {item.content}
                    </a>
                  ) : (
                    <p class="mt-2 text-steel-300 text-sm leading-relaxed">{item.content}</p>
                  )
                }
              </div>
            ))
          }
        </div>

        <div class="mt-6 pt-5 border-t border-steel-600/60 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-steel-400 text-center sm:text-left">
            {SITE.legalName} · полные реквизиты на странице контактов
          </p>
          <Button href="/kontakty/" variant="metal" size="md" class="shrink-0">
            Все контакты и реквизиты
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
