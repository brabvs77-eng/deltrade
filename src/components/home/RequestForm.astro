---
import SectionHeading from '../ui/SectionHeading.astro';
import { SITE } from '../../lib/constants';
---

<section class="py-14 sm:py-20 perforated-bg-light" id="zayavka">
  <div class="section-container">
    <SectionHeading
      title="Отправить заявку"
      subtitle="Опишите задачу или приложите спецификацию — менеджер свяжется с вами в рабочее время"
      align="center"
    />

    <form
      class="max-w-xl mx-auto rounded-2xl bg-white metal-border p-6 sm:p-8 space-y-4"
      method="POST"
      action="/api/request"
      enctype="multipart/form-data"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-steel-700 mb-1.5">Имя *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px] focus:outline-2 focus:outline-brand focus:outline-offset-0"
          placeholder="Иван Иванов"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-steel-700 mb-1.5">Телефон *</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          autocomplete="tel"
          class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px] focus:outline-2 focus:outline-brand focus:outline-offset-0"
          placeholder="+7 (___) ___-__-__"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-steel-700 mb-1.5">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px] focus:outline-2 focus:outline-brand focus:outline-offset-0"
          placeholder="info@company.ru"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-steel-700 mb-1.5">Комментарий</label>
        <textarea
          id="message"
          name="message"
          rows="3"
          class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base focus:outline-2 focus:outline-brand focus:outline-offset-0 resize-y"
          placeholder="Опишите задачу или перечислите позиции"
        ></textarea>
      </div>

      <div>
        <label for="file" class="block text-sm font-medium text-steel-700 mb-1.5">Спецификация (файл)</label>
        <input
          type="file"
          id="file"
          name="file"
          accept=".pdf,.xlsx,.xls,.doc,.docx,.csv"
          class="w-full text-sm text-steel-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:metal-surface file:metal-border file:text-steel-700 file:font-medium file:cursor-pointer"
        />
        <p class="mt-1 text-xs text-steel-400">PDF, Excel, Word, CSV — до 10 МБ</p>
      </div>

      <button
        type="submit"
        class="w-full inline-flex items-center justify-center px-8 py-4 text-lg font-semibold bg-brand text-white rounded-lg hover:bg-brand-light active:bg-brand-dark transition-colors min-h-[52px] shadow-md shadow-brand/20"
      >
        Отправить заявку
      </button>

      <p class="text-xs text-steel-400 text-center leading-relaxed">
        Нажимая кнопку, вы соглашаетесь с
        <a href="/politika-konfidencialnosti/" class="text-brand hover:underline">политикой конфиденциальности</a>
      </p>
    </form>

    <div class="mt-8 text-center text-sm text-steel-500">
      или позвоните: <a href={SITE.phoneHref} class="text-brand font-medium hover:underline">{SITE.phone}</a>
    </div>
  </div>
</section>
