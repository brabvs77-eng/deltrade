---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
---

<section class="py-14 sm:py-20 bg-white" id="kalkulyator">
  <div class="section-container">
    <SectionHeading
      title="Калькулятор металлопроката"
      subtitle="Рассчитайте вес, объём и ориентировочную стоимость за секунды"
    />

    <div class="rounded-2xl metal-border overflow-hidden">
      <!-- Metal header bar -->
      <div class="metal-surface px-5 py-3 flex items-center gap-2 border-b border-steel-300" aria-hidden="true">
        <div class="rivet"></div>
        <div class="rivet"></div>
        <div class="rivet"></div>
        <span class="ml-2 text-xs uppercase tracking-widest text-steel-500 font-medium">Онлайн-расчёт</span>
      </div>

      <div class="p-5 sm:p-8 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
        <!-- Quick calc preview -->
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-steel-700 mb-1.5">Сортамент</label>
            <select class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px]" disabled>
              <option>Арматура</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-steel-700 mb-1.5">Диаметр, мм</label>
              <input type="text" value="12" disabled class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px]" />
            </div>
            <div>
              <label class="block text-sm font-medium text-steel-700 mb-1.5">Длина, м</label>
              <input type="text" value="6" disabled class="w-full px-4 py-3 rounded-lg metal-border bg-surface text-steel-900 text-base min-h-[44px]" />
            </div>
          </div>
        </div>

        <!-- Result preview -->
        <div class="rounded-xl steel-section p-6 flex flex-col justify-center">
          <p class="text-steel-400 text-sm mb-4">Пример расчёта: Арматура А3 Ø12 × 6 м</p>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <span class="text-steel-500 text-xs uppercase tracking-wider">Вес</span>
              <p class="text-2xl font-bold text-white mt-1">5.33 <span class="text-base font-medium text-steel-400">кг</span></p>
            </div>
            <div>
              <span class="text-steel-500 text-xs uppercase tracking-wider">Объём</span>
              <p class="text-2xl font-bold text-white mt-1">0.0007 <span class="text-base font-medium text-steel-400">м³</span></p>
            </div>
            <div>
              <span class="text-steel-500 text-xs uppercase tracking-wider">Площадь</span>
              <p class="text-2xl font-bold text-white mt-1">0.23 <span class="text-base font-medium text-steel-400">м²</span></p>
            </div>
            <div>
              <span class="text-steel-500 text-xs uppercase tracking-wider">Ориентир</span>
              <p class="text-2xl font-bold text-brand-light mt-1">240 <span class="text-base font-medium text-steel-400">₽</span></p>
            </div>
          </div>
        </div>
      </div>

      <div class="px-5 sm:px-8 pb-6 sm:pb-8">
        <Button href="/kalkulyator-metalla/" variant="primary" size="lg" class="w-full sm:w-auto">
          Открыть полный калькулятор
        </Button>
        <p class="mt-3 text-xs text-steel-400">15 сортаментов · 50+ марок металла · спецификация · экспорт CSV</p>
      </div>
    </div>
  </div>
</section>
