---
import SectionHeading from '../ui/SectionHeading.astro';
import MetalCard from '../ui/MetalCard.astro';

const services = [
  {
    slug: 'metalloobrabotka',
    title: 'Металлообработка',
    description: 'Резка, гибка, сварка и другие виды обработки через проверенных партнёров.',
  },
  {
    slug: 'izgotovlenie-po-chertezham',
    title: 'Изготовление по чертежам',
    description: 'Производство деталей и конструкций по вашим техническим требованиям.',
  },
  {
    slug: 'komplektaciya',
    title: 'Комплектация',
    description: 'Сбор многопозиционных заявок в рамках одного проекта или объекта.',
  },
  {
    slug: 'logistika',
    title: 'Логистика',
    description: 'Организация доставки по России — от единичных позиций до крупных партий.',
  },
];
---

<section class="py-14 sm:py-20 perforated-bg-light">
  <div class="section-container">
    <SectionHeading
      title="Услуги"
      subtitle="Полный цикл — от подбора до доставки и документов"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
      {
        services.map((service) => (
          <MetalCard href={`/uslugi/${service.slug}/`}>
            <h3 class="font-bold text-steel-900 group-hover:text-brand transition-colors text-lg">
              {service.title}
            </h3>
            <p class="mt-2 text-sm text-steel-500 leading-relaxed">{service.description}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand group-hover:gap-2 transition-all">
              Подробнее
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </MetalCard>
        ))
      }
    </div>
  </div>
</section>
