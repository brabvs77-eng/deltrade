---
import SectionHeading from '../ui/SectionHeading.astro';
import MetalCard from '../ui/MetalCard.astro';
import ServiceImage from '../ui/ServiceImage.astro';
import Button from '../ui/Button.astro';
import { getAllServices } from '../../lib/services';

const services = getAllServices().slice(0, 4);
---

<section class="py-14 sm:py-20 perforated-bg-light">
  <div class="section-container">
    <SectionHeading
      title="Услуги металлообработки"
      subtitle="Резка, гибка, изготовление и покрытия — с материалом поставщика"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
      {
        services.map((service) => (
          <MetalCard href={`/uslugi/${service.slug}/`} class="!p-0 overflow-hidden">
            <div class="aspect-[16/10] overflow-hidden">
              <ServiceImage slug={service.slug} title={service.title} class="group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5 sm:p-6">
            <h3 class="font-bold text-steel-900 group-hover:text-brand transition-colors text-lg">
              {service.title}
            </h3>
            <p class="mt-2 text-sm text-steel-500 leading-relaxed">{service.shortDescription}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand group-hover:gap-2 transition-all">
              Подробнее
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            </div>
          </MetalCard>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <Button href="/uslugi/" variant="outline">Все услуги</Button>
    </div>
  </div>
</section>
