---
import SectionHeading from '../ui/SectionHeading.astro';
import MetalCard from '../ui/MetalCard.astro';
import DirectionImage from '../ui/DirectionImage.astro';
import { MAIN_DIRECTIONS } from '../../lib/constants';
---

<section class="py-14 sm:py-20 perforated-bg-light">
  <div class="section-container">
    <SectionHeading
      title="Три направления поставок"
      subtitle="Оптовый поставщик для предприятий и строительных организаций — без витрины «всё подряд»"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      {
        MAIN_DIRECTIONS.map((dir) => (
          <MetalCard class="!p-0 overflow-hidden h-full">
            <div class="aspect-[16/10] overflow-hidden">
              <DirectionImage slug={dir.slug === 'metalloobrabotka' ? 'metallokonstrukcii' : dir.slug} title={dir.title} class="group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5 sm:p-6 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-bold text-steel-900 group-hover:text-brand transition-colors text-lg leading-snug">
                  {dir.title}
                </h3>
                {dir.highlight && (
                  <span class="shrink-0 px-2 py-0.5 rounded text-xs font-bold bg-brand text-white uppercase tracking-wide">
                    {dir.highlight}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm text-steel-500 leading-relaxed flex-1">{dir.description}</p>
              {dir.links && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {dir.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="inline-block px-2.5 py-1 rounded-full text-xs font-medium bg-steel-100 text-steel-600 hover:bg-brand/10 hover:text-brand transition-colors"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <a
                href={dir.href}
                class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand hover:gap-2 transition-all"
              >
                Перейти в раздел
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </MetalCard>
        ))
      }
    </div>
  </div>
</section>
