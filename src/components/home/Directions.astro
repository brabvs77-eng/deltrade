---
import SectionHeading from '../ui/SectionHeading.astro';
import DirectionScroll from '../ui/DirectionScroll.astro';
import { CATALOG_DIRECTIONS } from '../../lib/constants';
import { getAllProducts } from '../../lib/catalog';

const products = getAllProducts();
const items = CATALOG_DIRECTIONS.map((dir) => ({
  href: `/katalog/${dir.slug}/`,
  title: dir.title,
  description: dir.description,
  slug: dir.slug,
  count: products.filter((p) => p.section === dir.slug).length,
}));
---

<section class="py-14 sm:py-20 perforated-bg-light">
  <div class="section-container">
    <SectionHeading
      title="Направления поставок"
      subtitle="Широкий ассортимент для строительных, производственных и промышленных предприятий"
    />
    <DirectionScroll items={items} showImages={true} />
  </div>
</section>
