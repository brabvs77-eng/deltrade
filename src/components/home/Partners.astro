---
import SectionHeading from '../ui/SectionHeading.astro';
import partners from '../../data/partners.json';
---

<section class="py-14 sm:py-20 bg-white">
  <div class="section-container">
    <SectionHeading
      title="Партнёры"
      subtitle="Работаем с ведущими производителями и логистическими компаниями"
      align="center"
    />

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto">
      {
        partners.map((partner) => (
          <div class="flex flex-col items-center justify-center gap-2 p-4 sm:p-5 rounded-xl metal-border bg-surface text-center min-h-[100px]">
            <img
              src={partner.logo}
              alt={`Логотип ${partner.name}`}
              width="160"
              height="56"
              loading="lazy"
              decoding="async"
              class="h-10 sm:h-12 w-auto max-w-[140px] object-contain"
            />
            <span class="text-xs text-steel-400">{partner.category}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
