---
import SectionHeading from '../ui/SectionHeading.astro';
import { WORK_STEPS } from '../../lib/constants';
---

<section class="py-14 sm:py-20 bg-white">
  <div class="section-container">
    <SectionHeading
      title="Как мы работаем"
      subtitle="От заявки до поставки и документов — прозрачный процесс"
      align="center"
    />

    <ol class="relative max-w-2xl mx-auto">
      <!-- Vertical metal line -->
      <div class="absolute left-[19px] sm:left-[23px] top-4 bottom-4 w-0.5 bg-gradient-to-b from-steel-300 via-brand/40 to-steel-300" aria-hidden="true"></div>

      {
        WORK_STEPS.map((step) => (
          <li class="relative flex gap-4 sm:gap-6 pb-8 last:pb-0">
            <div class="relative z-10 flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full metal-surface metal-border text-steel-700 font-bold text-sm sm:text-base shrink-0">
              {step.step}
            </div>
            <div class="pt-1.5 sm:pt-2">
              <h3 class="font-bold text-steel-900 text-base sm:text-lg">{step.title}</h3>
              <p class="mt-1 text-sm sm:text-base text-steel-500 leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
