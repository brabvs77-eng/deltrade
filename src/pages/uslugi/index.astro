---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import MetalCard from '../../components/ui/MetalCard.astro';
import ServiceImage from '../../components/ui/ServiceImage.astro';
import RequestFormBlock from '../../components/ui/RequestFormBlock.astro';
import { getAllServices } from '../../lib/services';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { SITE } from '../../lib/constants';

const services = getAllServices();
const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Услуги', url: `${SITE.url}/uslugi/` },
]);
---

<BaseLayout
  title="Услуги"
  description="Металлообработка, изготовление по чертежам, комплектация и логистика. DELDIN TRADE — полный цикл поставки металлопроката."
  path="/uslugi/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <PageHero
    title="Услуги"
    subtitle="Полный цикл — от подбора металлопроката до обработки, доставки и документов"
    breadcrumb={[{ label: 'Главная', href: '/' }, { label: 'Услуги' }]}
  />

  <section class="py-10 sm:py-14">
    <div class="section-container">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          services.map((service) => (
            <MetalCard href={`/uslugi/${service.slug}/`} class="!p-0 overflow-hidden">
              <div class="aspect-[16/10] overflow-hidden">
                <ServiceImage slug={service.slug} title={service.title} class="group-hover:scale-105 transition-transform duration-300" />
              </div>
              <div class="p-5 sm:p-6">
                <h2 class="text-xl font-bold text-steel-900 group-hover:text-brand transition-colors">
                  {service.title}
                </h2>
                <p class="mt-2 text-sm text-steel-500 leading-relaxed">{service.shortDescription}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand group-hover:gap-2 transition-all">
                  Подробнее
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </MetalCard>
          ))
        }
      </div>
    </div>
  </section>

  <RequestFormBlock />
</BaseLayout>
