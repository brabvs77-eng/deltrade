---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Directions from '../components/home/Directions.astro';
import ComplexOrder from '../components/home/ComplexOrder.astro';
import HowWeWork from '../components/home/HowWeWork.astro';
import Services from '../components/home/Services.astro';
import Industries from '../components/home/Industries.astro';
import Cases from '../components/home/Cases.astro';
import BlogTeaser from '../components/home/BlogTeaser.astro';
import Partners from '../components/home/Partners.astro';
import Documents from '../components/home/Documents.astro';
import Geography from '../components/home/Geography.astro';
import CalculatorTeaser from '../components/home/CalculatorTeaser.astro';
import RequestFormBlock from '../components/ui/RequestFormBlock.astro';
import Contacts from '../components/home/Contacts.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout
  title="Комплексные поставки металлопроката"
  description={SITE.description}
  path="/"
>
  <Hero />
  <Directions />
  <ComplexOrder />
  <HowWeWork />
  <Services />
  <Industries />
  <Cases />
  <BlogTeaser />
  <Partners />
  <Documents />
  <Geography />
  <CalculatorTeaser />
  <RequestFormBlock />
  <Contacts />
</BaseLayout>
