---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Calculator from '../../components/calculator/Calculator';
import { SITE } from '../../lib/constants';

const faqItems = [
  {
    q: 'Какие сортаменты поддерживает калькулятор?',
    a: '15 типов: лист, плита, круг, квадрат, шестигранник, полоса, лента/шина, труба, профильная труба, проволока, уголок, швеллер, двутавр, арматура и пользовательский профиль.',
  },
  {
    q: 'Насколько точен расчёт веса?',
    a: 'Калькулятор выполняет теоретический расчёт по номинальным размерам и плотности ГОСТ/ТУ. Фактический вес может отличаться в пределах ±1–3% из-за допусков на прокат.',
  },
  {
    q: 'Можно ли рассчитать стоимость партии?',
    a: 'Да. Укажите ориентировочную цену за кг — калькулятор покажет базовую сумму. Для официального КП с НДС и доставкой отправьте спецификацию менеджеру.',
  },
  {
    q: 'Как отправить расчёт менеджеру?',
    a: 'Добавьте позиции в спецификацию и нажмите «Отправить спецификацию менеджеру» — спецификация подставится в форму заявки. Также доступны экспорт CSV, печать/PDF и копирование в буфер.',
  },
  {
    q: 'Какие марки металла доступны?',
    a: 'Более 50 марок: Ст3, 09Г2С, 40Х, А3, Х12МФ, 9ХС, Р6М5, AISI 304/316/321, медь, латунь, бронза, алюминий, титан, цинк, никель и другие. Можно указать свою плотность.',
  },
  {
    q: 'Что такое обратный расчёт по весу?',
    a: 'Режимы «По весу → длина» и «По весу → кол-во» позволяют задать целевой вес партии и получить нужную длину заготовки или количество штук.',
  },
  {
    q: 'Можно ли перейти в калькулятор с карточки товара?',
    a: 'Да. На странице товара кнопка «Рассчитать вес» подставляет сортамент, марку и размеры из каталога.',
  },
  {
    q: 'Подходит ли калькулятор для тендерных расчётов?',
    a: 'Калькулятор даёт ориентировочный вес и стоимость для предварительной оценки. Для тендерной документации запросите официальное КП у менеджера с актуальными ценами и НДС.',
  },
  {
    q: 'Какие единицы измерения используются?',
    a: 'Размеры — в миллиметрах (длина может быть в метрах), вес — в килограммах, объём — в кубических метрах, площадь — в квадратных метрах.',
  },
  {
    q: 'Бесплатен ли калькулятор?',
    a: 'Да, калькулятор полностью бесплатный и доступен без регистрации. Собранную спецификацию можно отправить менеджеру DELDIN TRADE для получения коммерческого предложения.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Калькулятор металлопроката DELDIN TRADE',
  url: `${SITE.url}/kalkulyator-metalla/`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
};
---

<BaseLayout
  title="Калькулятор металлопроката — вес, объём и стоимость"
  description="Онлайн-калькулятор металлопроката: расчёт веса, объёма, площади и ориентировочной стоимости. 15 сортаментов, 50+ марок металла. Спецификация, CSV, PDF и передача в заявку."
  path="/kalkulyator-metalla/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <!-- Hero -->
  <section class="steel-section py-10 sm:py-14">
    <div class="section-container relative">
      <div class="max-w-2xl">
        <p class="text-steel-500 text-xs uppercase tracking-widest mb-3">Онлайн-инструмент</p>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
          Калькулятор металлопроката
        </h1>
        <p class="mt-3 text-steel-300 text-base sm:text-lg leading-relaxed">
          Рассчитайте вес, объём, площадь и ориентировочную стоимость за секунды.
          Соберите спецификацию и отправьте менеджеру.
        </p>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="py-10 sm:py-14">
    <div class="section-container">
      <div class="rounded-2xl metal-border overflow-hidden bg-white">
        <div class="metal-surface px-5 py-3 border-b border-steel-300 flex items-center gap-2" aria-hidden="true">
          <div class="rivet"></div>
          <div class="rivet"></div>
          <div class="rivet"></div>
          <span class="ml-2 text-xs uppercase tracking-widest text-steel-500 font-medium">Расчёт по ГОСТ</span>
        </div>
        <div class="p-5 sm:p-8">
          <Calculator client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- SEO content -->
  <section class="py-10 sm:py-14 perforated-bg-light">
    <div class="section-container max-w-3xl">
      <SectionHeading
        title="Как пользоваться калькулятором"
        subtitle="Пять шагов для точного расчёта заготовки или партии"
      />
      <ol class="space-y-4">
        {[
          ['Выберите сортамент', 'Лист, труба, арматура, уголок и другие — 15 типов профилей.'],
          ['Укажите марку металла', 'Плотность подставится автоматически. Доступны стали, нержавейка и цветные металлы.'],
          ['Введите размеры', 'Толщина, диаметр, длина — в миллиметрах или метрах.'],
          ['Укажите количество и цену', 'Калькулятор покажет вес партии и ориентировочную стоимость.'],
          ['Добавьте в спецификацию', 'Соберите несколько позиций, скачайте CSV или отправьте менеджеру.'],
        ].map(([title, desc], i) => (
          <li class="flex gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-full metal-surface metal-border text-steel-700 font-bold text-sm shrink-0">
              {i + 1}
            </span>
            <div>
              <h3 class="font-semibold text-steel-900">{title}</h3>
              <p class="text-sm text-steel-500 mt-0.5">{desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-12 space-y-6 text-steel-600 leading-relaxed text-sm sm:text-base">
        <h2 class="text-xl font-bold text-steel-900">Онлайн-калькулятор металлопроката для B2B-закупок</h2>
        <p>
          Калькулятор металлопроката DELDIN TRADE создан для снабженцев, прорабов, инженеров-проектировщиков и закупщиков,
          которым нужно быстро оценить вес партии до отправки спецификации поставщику. Инструмент поддерживает 15 типов
          сортамента — от листа и арматуры до двутавра и профильной трубы — и более 50 марок металла с автоматической
          подстановкой плотности по ГОСТ.
        </p>
        <p>
          Теоретический вес рассчитывается по геометрии сечения и плотности выбранной марки. Это стандартный подход
          металлобаз и трейдеров: фактический вес при отгрузке может отличаться на 1–3% из-за допусков проката,
          радиусов сгиба уголка и швеллера, а также точности нарезки. Для смет и логистики калькулятор даёт достаточно
          точную оценку, а для договора — запросите коммерческое предложение с весом по сертификату завода.
        </p>
        <h3 class="text-lg font-bold text-steel-900 pt-2">Режимы расчёта</h3>
        <p>
          Прямой режим «По размерам» — классический: вы задаёте сечение, длину и количество, получаете вес одной штуки
          и общий вес партии. Обратный режим «По весу → длина» полезен, когда нужно уложиться в заданную массу:
          например, определить длину прутка арматуры под лимит веса крана. Режим «По весу → кол-во» подскажет,
          сколько штук потребуется для достижения целевого веса — удобно при комплектации складских остатков.
        </p>
        <h3 class="text-lg font-bold text-steel-900 pt-2">Спецификация и экспорт</h3>
        <p>
          Собранная спецификация — это перечень позиций с сортаментом, маркой, размерами, количеством, весом и
          ориентировочной стоимостью. Её можно скачать в CSV для Excel, скопировать в буфер обмена, отправить на
          печать (PDF) или передать менеджеру через форму заявки на сайте — спецификация автоматически подставится
          в поле комментария. Это сокращает время согласования: менеджер видит ваш расчёт и готовит КП быстрее.
        </p>
        <h3 class="text-lg font-bold text-steel-900 pt-2">Связь с каталогом</h3>
        <p>
          На карточках товаров каталога DELDIN TRADE есть кнопка «Рассчитать вес» — она открывает калькулятор с
          предзаполненными параметрами позиции (сортамент, марка, типовые размеры). Так вы можете сразу скорректировать
          длину или количество под свой проект и добавить позицию в спецификацию вместе с другими изделиями.
        </p>
        <p>
          DELDIN TRADE — металлотрейдер и комплексный B2B-поставщик. Помимо расчёта веса мы подбираем продукцию по
          спецификации, находим редкие позиции, организуем резку и доставку на объект по России. Отправьте заявку или
          позвоните в рабочее время — менеджер подготовит коммерческое предложение с НДС и актуальными сроками поставки.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="section-container max-w-3xl">
      <SectionHeading title="Частые вопросы" />
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group rounded-xl metal-border bg-surface p-4 sm:p-5">
            <summary class="font-semibold text-steel-900 cursor-pointer list-none flex justify-between items-center">
              {item.q}
              <span class="text-steel-400 group-open:rotate-45 transition-transform text-xl ml-2">+</span>
            </summary>
            <p class="mt-3 text-sm text-steel-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
