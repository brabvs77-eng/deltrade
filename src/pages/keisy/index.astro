---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import MetalCard from '../../components/ui/MetalCard.astro';
import RequestFormBlock from '../../components/ui/RequestFormBlock.astro';
import { getAllCases } from '../../lib/cases';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { SITE } from '../../lib/constants';

const cases = getAllCases();
const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Кейсы', url: `${SITE.url}/keisy/` },
]);
---

<BaseLayout
  title="Реализованные поставки"
  description="Кейсы DELDIN TRADE: реальные поставки металлопроката для строительства, промышленности и машиностроения. Задача, решение, сроки и результат."
  path="/keisy/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <PageHero
    title="Реализованные поставки"
    subtitle="Задача, решение, номенклатура, география и срок"
    breadcrumb={[{ label: 'Главная', href: '/' }, { label: 'Кейсы' }]}
  />

  <section class="py-8 sm:py-10 bg-white border-b border-steel-200">
    <div class="section-container max-w-3xl">
      <p class="text-steel-600 leading-relaxed">
        DELDIN TRADE поставляет металлопрокат и комплектующие для строительства, промышленности,
        логистики и машиностроения по всей России. Ниже — примеры реальных проектов: от комплектации
        арматуры на жилой комплекс до поставки редких марок стали под заказ. В каждом кейсе —
        задача заказчика, наше решение, номенклатура и измеримый результат.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {
          cases.map((c) => (
            <MetalCard href={`/keisy/${c.slug}/`}>
              {
                c.image && (
                  <div class="aspect-[16/10] rounded-lg overflow-hidden mb-4 metal-border">
                    <img
                      src={c.image}
                      alt={c.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="640"
                      height="400"
                    />
                  </div>
                )
              }
              <div class="flex items-center gap-2 mb-3">
                <span class="px-2 py-0.5 rounded text-xs font-medium bg-brand/10 text-brand">{c.industry}</span>
                <span class="text-xs text-steel-400">{c.region} · {c.duration}</span>
              </div>
              <h2 class="text-lg font-bold text-steel-900 group-hover:text-brand transition-colors">{c.title}</h2>
              <p class="mt-2 text-sm text-steel-500 line-clamp-3">{c.intro ?? c.task}</p>
              {
                c.stats && c.stats.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {c.stats.slice(0, 2).map((stat) => (
                      <span class="px-2 py-1 rounded-md text-xs font-medium bg-steel-100 text-steel-600">
                        {stat.value} — {stat.label.toLowerCase()}
                      </span>
                    ))}
                  </div>
                )
              }
            </MetalCard>
          ))
        }
      </div>
    </div>
  </section>

  <RequestFormBlock title="Обсудить ваш проект" />
</BaseLayout>
