---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import RequestFormBlock from '../../components/ui/RequestFormBlock.astro';
import { getAllCases } from '../../lib/cases';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { SITE } from '../../lib/constants';

export function getStaticPaths() {
  return getAllCases().map((c) => ({ params: { slug: c.slug }, props: { caseStudy: c } }));
}

const { caseStudy } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: caseStudy.title,
  description: caseStudy.intro ?? caseStudy.task,
  image: caseStudy.image ? `${SITE.url}${caseStudy.image}` : undefined,
  author: { '@type': 'Organization', name: SITE.legalName },
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Кейсы', url: `${SITE.url}/keisy/` },
  { name: caseStudy.title, url: `${SITE.url}/keisy/${caseStudy.slug}/` },
]);
---

<BaseLayout
  title={caseStudy.title}
  description={caseStudy.intro ?? caseStudy.task}
  path={`/keisy/${caseStudy.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <PageHero
    title={caseStudy.title}
    subtitle={`${caseStudy.industry} · ${caseStudy.region} · ${caseStudy.duration}`}
    breadcrumb={[
      { label: 'Главная', href: '/' },
      { label: 'Кейсы', href: '/keisy/' },
      { label: caseStudy.title },
    ]}
  />

  <section class="py-10 sm:py-14">
    <div class="section-container max-w-3xl">
      {
        caseStudy.image && (
          <div class="aspect-[16/10] rounded-xl overflow-hidden metal-border mb-8">
            <img
              src={caseStudy.image}
              alt={caseStudy.title}
              class="w-full h-full object-cover"
              loading="eager"
              width="960"
              height="600"
            />
          </div>
        )
      }

      {
        caseStudy.intro && (
          <p class="text-steel-600 leading-relaxed text-base sm:text-lg mb-8">{caseStudy.intro}</p>
        )
      }

      {
        caseStudy.stats && caseStudy.stats.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
            {caseStudy.stats.map((stat) => (
              <div class="rounded-xl metal-border bg-surface p-4 text-center">
                <p class="text-xl sm:text-2xl font-bold text-brand">{stat.value}</p>
                <p class="mt-1 text-xs text-steel-500">{stat.label}</p>
              </div>
            ))}
          </div>
        )
      }

      <div class="space-y-8">
        {
          caseStudy.context && (
            <div>
              <h2 class="text-lg font-bold text-steel-900 mb-2">Контекст проекта</h2>
              <p class="text-steel-600 leading-relaxed">{caseStudy.context}</p>
            </div>
          )
        }
        <div>
          <h2 class="text-lg font-bold text-steel-900 mb-2">Задача</h2>
          <p class="text-steel-600 leading-relaxed">{caseStudy.task}</p>
        </div>
        <div>
          <h2 class="text-lg font-bold text-steel-900 mb-2">Решение</h2>
          <p class="text-steel-600 leading-relaxed">{caseStudy.solution}</p>
        </div>
        {
          caseStudy.steps && caseStudy.steps.length > 0 && (
            <div>
              <h2 class="text-lg font-bold text-steel-900 mb-4">Этапы работы</h2>
              <ol class="space-y-3">
                {caseStudy.steps.map((step, i) => (
                  <li class="flex gap-4">
                    <span class="flex items-center justify-center w-7 h-7 rounded-full metal-surface metal-border text-steel-700 font-bold text-xs shrink-0">
                      {i + 1}
                    </span>
                    <p class="text-steel-600 leading-relaxed text-sm sm:text-base pt-0.5">{step}</p>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        <div>
          <h2 class="text-lg font-bold text-steel-900 mb-2">Номенклатура</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {caseStudy.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-steel-600">
                <svg class="w-4 h-4 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl steel-section p-6">
          <h2 class="text-lg font-bold text-white mb-2">Результат</h2>
          <p class="text-steel-300 leading-relaxed">{caseStudy.result}</p>
        </div>
      </div>

      <div class="mt-8">
        <Button href="/#zayavka" variant="primary" size="lg">Обсудить похожий проект</Button>
      </div>
    </div>
  </section>

  <RequestFormBlock />
</BaseLayout>
