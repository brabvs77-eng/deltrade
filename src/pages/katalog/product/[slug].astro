---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/ui/Button.astro';
import ProductImage from '../../../components/ui/ProductImage.astro';
import MetalCard from '../../../components/ui/MetalCard.astro';
import {
  getAllProducts,
  getSectionTitle,
  getSubsectionTitle,
  getProductBySlug,
} from '../../../lib/catalog';
import { getProductImage } from '../../../lib/images';
import { breadcrumbSchema } from '../../../lib/seo/schema';
import { SITE } from '../../../lib/constants';

export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const sectionTitle = getSectionTitle(product.section);
const subsectionTitle = getSubsectionTitle(product.section, product.subsection);
const pricePerKg = product.pricePerTon > 0 ? (product.pricePerTon / 1000).toFixed(0) : null;
const paragraphs = product.description.split('\n\n');
const faq = product.faq ?? [];
const relatedProducts = (product.relatedSlugs ?? [])
  .map((slug) => getProductBySlug(slug))
  .filter(Boolean);

const calcParams = new URLSearchParams({
  profile: product.calculatorPreset.profileId,
  metal: product.calculatorPreset.metalId,
  ...Object.fromEntries(
    Object.entries(product.calculatorPreset.dimensions).map(([k, v]) => [k, String(v)]),
  ),
});
const calcHref = `/kalkulyator-metalla/?${calcParams.toString()}`;

const productImage = `${SITE.url}${getProductImage(product.slug, product.subsection)}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description.replace(/\n/g, ' '),
  image: productImage,
  brand: { '@type': 'Brand', name: 'DELDIN TRADE' },
  sku: product.slug,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'RUB',
    price: product.pricePerUnit ?? pricePerKg ?? '0',
    priceSpecification: product.pricePerUnit
      ? {
          '@type': 'UnitPriceSpecification',
          price: product.pricePerUnit,
          priceCurrency: 'RUB',
          unitText: 'единица',
        }
      : product.pricePerTon > 0
        ? {
            '@type': 'UnitPriceSpecification',
            price: product.pricePerTon,
            priceCurrency: 'RUB',
            unitText: 'тонна',
          }
        : undefined,
    availability: 'https://schema.org/PreOrder',
    seller: { '@type': 'Organization', name: SITE.legalName },
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'ГОСТ', value: product.gost },
    { '@type': 'PropertyValue', name: 'Марка стали', value: product.steelGrade },
    ...(product.weightPerMeter > 0
      ? [{ '@type': 'PropertyValue', name: 'Вес погонного метра', value: `${product.weightPerMeter} кг/м` }]
      : []),
  ],
};

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Каталог', url: `${SITE.url}/katalog/` },
  { name: sectionTitle, url: `${SITE.url}/katalog/${product.section}/` },
  { name: product.title, url: `${SITE.url}/katalog/product/${product.slug}/` },
]);
---

<BaseLayout
  title={product.title}
  description={`${product.title} — ${product.gost}, марка ${product.steelGrade}. ${product.weightPerMeter > 0 ? `Вес ${product.weightPerMeter} кг/м. ` : ''}Поставка по спецификации, доставка по России.`}
  path={`/katalog/product/${product.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="py-8 sm:py-12">
    <div class="section-container">
      <nav class="text-sm text-steel-500 mb-6" aria-label="Хлебные крошки">
        <a href="/katalog/" class="hover:text-brand">Каталог</a>
        <span class="mx-1.5">/</span>
        <a href={`/katalog/${product.section}/`} class="hover:text-brand">{sectionTitle}</a>
        <span class="mx-1.5">/</span>
        <span class="text-steel-700">{product.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <div class="aspect-[4/3] rounded-xl overflow-hidden metal-border relative">
          <ProductImage slug={product.slug} subsection={product.subsection} title={product.title} />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-steel-900/80 to-transparent p-4">
            <p class="text-white text-sm font-medium">{product.gost}</p>
            <p class="text-steel-300 text-xs mt-0.5">{subsectionTitle}</p>
          </div>
        </div>

        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-steel-900 leading-tight">{product.h1}</h1>

          <table class="mt-6 w-full text-sm">
            <tbody class="divide-y divide-steel-200">
              <tr><td class="py-2 text-steel-500 w-2/5">ГОСТ</td><td class="py-2 font-medium">{product.gost}</td></tr>
              <tr><td class="py-2 text-steel-500">Марка / материал</td><td class="py-2 font-medium">{product.steelGrade}</td></tr>
              {
                product.weightPerMeter > 0 && (
                  <tr>
                    <td class="py-2 text-steel-500">Вес погонного метра</td>
                    <td class="py-2 font-medium">{product.weightPerMeter} кг/м</td>
                  </tr>
                )
              }
              <tr>
                <td class="py-2 text-steel-500">Цена ориентир</td>
                <td class="py-2 font-medium text-brand">
                  {
                    product.pricePerUnit
                      ? `от ${product.pricePerUnit.toLocaleString('ru-RU')} ₽/ед.`
                      : pricePerKg
                        ? `от ${pricePerKg} ₽/кг (${product.pricePerTon.toLocaleString('ru-RU')} ₽/т)`
                        : 'по запросу'
                  }
                </td>
              </tr>
            </tbody>
          </table>

          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <Button href="/#zayavka" variant="primary" size="lg" class="w-full sm:w-auto">
              Запросить расчёт
            </Button>
            <Button href={calcHref} variant="outline" size="lg" class="w-full sm:w-auto" data-calc-preset>
              Рассчитать вес
            </Button>
          </div>

          <p class="mt-3 text-xs text-steel-400">Цена ориентировочная, не является публичной офертой</p>
        </div>
      </div>

      <div class="mt-12 max-w-3xl">
        <h2 class="text-xl font-bold text-steel-900 mb-4">Описание</h2>
        {paragraphs.map((p) => (
          <p class="text-steel-600 leading-relaxed mb-4">{p}</p>
        ))}

        <h3 class="text-lg font-bold text-steel-900 mt-8 mb-3">Применение</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {product.useCases.map((use) => (
            <li class="flex items-center gap-2 text-sm text-steel-600">
              <svg class="w-4 h-4 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {use}
            </li>
          ))}
        </ul>
      </div>

      {
        faq.length > 0 && (
          <div class="mt-12 max-w-3xl">
            <h2 class="text-xl font-bold text-steel-900 mb-4">Частые вопросы</h2>
            <div class="space-y-3">
              {faq.map((item) => (
                <details class="group rounded-xl metal-border bg-surface p-4 sm:p-5">
                  <summary class="font-semibold text-steel-900 cursor-pointer list-none flex justify-between items-center">
                    {item.question}
                    <span class="text-steel-400 group-open:rotate-45 transition-transform text-xl ml-2">+</span>
                  </summary>
                  <p class="mt-3 text-sm text-steel-600 leading-relaxed">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )
      }

      {
        relatedProducts.length > 0 && (
          <div class="mt-14">
            <h2 class="text-xl font-bold text-steel-900 mb-6">Похожие позиции</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {relatedProducts.map((rel) => (
                <MetalCard href={`/katalog/product/${rel!.slug}/`}>
                  <div class="aspect-[4/3] rounded-lg overflow-hidden mb-3 metal-border">
                    <ProductImage slug={rel!.slug} subsection={rel!.subsection} title={rel!.title} thumb />
                  </div>
                  <h3 class="font-semibold text-steel-900 group-hover:text-brand transition-colors text-sm">
                    {rel!.title}
                  </h3>
                  <p class="mt-1 text-xs text-steel-400">{rel!.gost}</p>
                </MetalCard>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>

  <script define:vars={{ preset: product.calculatorPreset }}>
    const key = 'deldin-calc-preset';
    document.querySelector('[data-calc-preset]')?.addEventListener('click', () => {
      sessionStorage.setItem(key, JSON.stringify(preset));
    });
  </script>
</BaseLayout>
