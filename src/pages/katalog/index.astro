---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import DirectionScroll from '../../components/ui/DirectionScroll.astro';
import { CATALOG_DIRECTIONS } from '../../lib/constants';
import { getAllProducts } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { SITE } from '../../lib/constants';

const products = getAllProducts();
const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Каталог', url: `${SITE.url}/katalog/` },
]);

const directionItems = CATALOG_DIRECTIONS.map((dir) => ({
  href: `/katalog/${dir.slug}/`,
  title: dir.title,
  description: dir.description,
  slug: dir.slug,
  count: products.filter((p) => p.section === dir.slug).length,
}));
---

<BaseLayout
  title="Каталог металлопроката и материалов"
  description="Каталог DELDIN TRADE: металлопрокат, спецстали, инженерные системы, кровля, комплексная комплектация. Поставка по спецификации с доставкой по России."
  path="/katalog/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <section class="steel-section py-10 sm:py-14">
    <div class="section-container">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white">Каталог</h1>
      <p class="mt-3 text-steel-300 max-w-2xl">
        10 направлений поставок: от металлопроката до комплексной комплектации объекта. {products.length} позиций в каталоге.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14 perforated-bg-light">
    <div class="section-container">
      <SectionHeading title="Направления" subtitle="Выберите раздел или отправьте спецификацию — подберём позиции под задачу" />
      <DirectionScroll items={directionItems} showImages={true} />
    </div>
  </section>
</BaseLayout>
