---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import MetalCard from '../../components/ui/MetalCard.astro';
import { CATALOG_DIRECTIONS } from '../../lib/constants';
import { getAllProducts } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { SITE } from '../../lib/constants';

const products = getAllProducts();
const breadcrumbs = breadcrumbSchema([
  { name: 'Главная', url: SITE.url },
  { name: 'Каталог', url: `${SITE.url}/katalog/` },
]);
---

<BaseLayout
  title="Каталог металлопроката и материалов"
  description="Каталог металлопроката DELDIN TRADE: арматура, трубы, лист, уголок, швеллер, двутавр. Комплексные поставки по спецификации с доставкой по России."
  path="/katalog/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <section class="steel-section py-10 sm:py-14">
    <div class="section-container">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white">Каталог</h1>
      <p class="mt-3 text-steel-300 max-w-2xl">
        Металлопрокат, инженерные системы и стройматериалы. Запросите расчёт по спецификации.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14 perforated-bg-light">
    <div class="section-container">
      <SectionHeading title="Направления" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          CATALOG_DIRECTIONS.map((dir) => {
            const count = products.filter((p) => p.section === dir.slug).length;
            return (
              <MetalCard href={`/katalog/${dir.slug}/`}>
                <h2 class="font-bold text-steel-900 group-hover:text-brand transition-colors text-lg">
                  {dir.title}
                </h2>
                <p class="mt-1 text-sm text-steel-500">{dir.description}</p>
                {count > 0 && (
                  <span class="mt-2 inline-block text-xs text-brand font-medium">{count} позиций</span>
                )}
              </MetalCard>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
